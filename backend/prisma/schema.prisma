generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                    @id @default(autoincrement())
  email             String                 @unique
  password          String
  name              String
  fatherName        String?
  collegeName       String?
  branchName        String?
  bio               String?
  avatarUrl         String?
  points            Int                    @default(0)
  badges            String[]               @default([])
  grade             String?                @default("N/A")
  progress          Int                    @default(0)
  courseType        String                 @default("Electronics")
  role              String                 @default("USER")
  isVerified        Boolean                @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime               @default(now())
  certificateStartDate DateTime?
  certificateEndDate   DateTime?
  streak            Int                    @default(0)
  // lastActiveAt starts null so a brand-new user isn't shown as "already solved today"
  // (issue #74); only an actual daily-challenge submission sets it.
  lastActiveAt      DateTime?
  referralCode      String?                @unique
  referredBy        String?
  assignments       AssignmentSubmission[]
  certificates      CertificateRecord[]
  internships       Internship[]
  challengeProgresses ChallengeProgress[]
  progresses        CourseProgress[]
  discussions       Discussion[]
  comments          ForumComment[]
  enrollments       Enrollment[]
  internshipApplications InternshipApplication[]
  moduleProgresses  ModuleProgress[]
  payments          Payment[]
  practiceAttempts  PracticeAttempt[]
  projects          ProjectSubmission[]
  results           QuizResult[]
  topicProgresses   TopicProgress[]
}

model CourseProgress {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String   // "C", "C++", "IoT", "Embedded"
  course        Course   @relation(fields: [courseId], references: [id])
  weekCompleted Int      @default(0) // 0 to 4
  progress      Int      @default(0) // 0 to 100
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model QuizResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  String   @default("C")
  week      Int      @default(1)
  score     Int
  accuracy  Int      @default(0)
  grade     String?
  passed    Boolean
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

model Category {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  description String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  courses     Course[]   @relation("CourseCategory")
  subcourses  Course[]   @relation("CourseSubcategory")
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Course {
  id                  String              @id
  title               String
  description         String
  price               Int                 @default(699)
  isPublished         Boolean             @default(true)
  // --- Phase 1: Dynamic Course Catalog (additive, backward-compatible) ---
  slug                String?             @unique
  shortTitle          String?
  shortDescription    String?
  categoryId          Int?
  subcategoryId       Int?
  category            Category?           @relation("CourseCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory         Category?           @relation("CourseSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  courseType          String?
  difficulty          String?
  duration            String?
  language            String?
  instructor          String?
  thumbnail           String?
  banner              String?
  status              String              @default("PUBLISHED")
  certificateAvailable Boolean            @default(true)
  prerequisites       String[]            @default([])
  learningOutcomes    String[]            @default([])
  targetAudience      String[]            @default([])
  skillsGained        String[]            @default([])
  tags                String[]            @default([])
  featured            Boolean             @default(false)
  // TASK 6: admin-controlled "Coming Soon" state. When true the course stays
  // visible in the catalog but its CTA is disabled (no availability implied).
  comingSoon          Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  progresses          CourseProgress[]
  challenges          Challenge[]
  enrollments         Enrollment[]
  finalExamQuestions  FinalExamQuestion[]
  modules             Module[]
  payments            Payment[]
  projectSubmissions  ProjectSubmission[]
  results             QuizResult[]
}

model Module {
  id            Int              @id @default(autoincrement())
  courseId      String
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  week          Int
  title         String
  description   String
  topics        Topic[]
  quizQuestions QuizQuestion[]
  progresses    ModuleProgress[]
  challenges    Challenge[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([courseId, week])
  @@index([courseId])
}

model Topic {
  id            Int             @id @default(autoincrement())
  moduleId      Int
  title         String
  text          String
  code          String?
  note          String?
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  module        Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  progresses    TopicProgress[]

  @@index([moduleId])
}

model QuizQuestion {
  id            Int      @id @default(autoincrement())
  moduleId      Int
  topicId       Int?
  text          String
  options       String[]
  correctAnswer String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topic         Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([topicId])
}

model Payment {
  id            String   @id @default(uuid())
  userId        Int
  courseId      String
  transactionId String?  @unique
  amount        Int
  status        String   @default("PENDING")
  reference     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

model Enrollment {
  id         String   @id @default(cuid())
  // userId is Int (not String) to match User.id Int — the FK must reference
  // the actual User primary key type.
  userId     Int
  courseId   String
  // Access states: ACTIVE = learning access; SUSPENDED / EXPIRED = no premium
  // access. String (not enum) to match the project's convention (issue #77).
  status     String   @default("ACTIVE")
  enrolledAt DateTime @default(now())
  source     String?  // e.g. "PAYMENT" (backfilled from verified payments)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, status])
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  category      String
  difficulty    String
  description   String
  documentation String
  codeSnippet   String?
  schematicUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Discussion {
  id        Int            @id @default(autoincrement())
  title     String
  content   String
  userId    Int
  courseId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  ForumComment[]

  @@index([userId])
}

model ForumComment {
  id        Int        @id @default(autoincrement())
  content   String
  postId    Int
  userId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  post      Discussion @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model PracticeQuestion {
  id            Int      @id @default(autoincrement())
  category      String
  topic         String
  difficulty    String
  text          String
  options       String[]
  correctAnswer String
  explanation   String?
  createdAt     DateTime @default(now())
}

model PracticeAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int
  score          Int
  totalQuestions Int
  category       String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CertificateRecord {
  id                 String    @id @default(uuid())
  userId             Int
  courseId           String? // null when certificateType = INTERNSHIP
  internshipId       String? @unique // set when certificateType = INTERNSHIP (1:1 with Internship)
  certificateType    String    @default("TRAINING") // TRAINING | INTERNSHIP (issue #102)
  verificationCode   String    @unique
  verificationStatus String    @default("PENDING") // PENDING | VERIFIED — admin-controlled (issue #101)
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship         Internship? @relation(fields: [internshipId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Internship {
  id                  String    @id @default(cuid())
  userId              Int
  programTitle        String
  domain              String
  role                String
  startDate           DateTime?
  endDate             DateTime?
  duration            String?
  institution         String?
  branch              String?
  session             String?
  mentorName          String?
  projectTitle        String?
  performanceGrade    String?
  completionNotes     String?
  remarks             String?
  status              String    @default("APPLIED") // APPLIED | SELECTED | ACTIVE | COMPLETED
  certificateEligible Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate         CertificateRecord?

  @@index([userId])
  @@index([status])
}

model AssignmentSubmission {
  id            Int      @id @default(autoincrement())
  userId        Int
  courseId      String
  weekNumber    Int
  fileUrl       String
  fileName      String
  status        String   @default("PENDING")
  feedback      String?
  shareSolution Boolean  @default(true) // privacy opt-out (issue #75)
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, weekNumber])
  @@index([userId, courseId])
}

model ProjectSubmission {
  id            Int      @id @default(autoincrement())
  userId        Int
  courseId      String
  title         String
  description   String
  sourceCodeUrl String
  reportUrl     String
  githubUrl     String?
  status        String   @default("PENDING")
  feedback      String?
  shareSolution Boolean  @default(true) // privacy opt-out (issue #75)
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, courseId])
}

model ModuleProgress {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseId   String
  moduleId   Int
  completed  Boolean  @default(false)
  quizPassed Boolean  @default(false)
  quizScore  Int?
  updatedAt  DateTime @updatedAt
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId, courseId])
}

model FinalExamQuestion {
  id            Int      @id @default(autoincrement())
  courseId      String
  text          String
  options       String[]
  correctAnswer String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TopicProgress {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseId   String
  topicId    Int
  completed  Boolean  @default(false)
  quizPassed Boolean  @default(false)
  quizScore  Int?
  updatedAt  DateTime @updatedAt
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, courseId])
}

model Challenge {
  id            Int                @id @default(autoincrement())
  courseId      String
  moduleId      Int
  title         String
  dashedName    String
  challengeType String             // "HTML" | "CSS" | "JavaScript" | "Python" | "SQL"
  description   String             // markdown (--description--)
  instructions  String             // markdown (--instructions--)
  seedCode      String             // starter code; for SQL = DB bootstrap SQL
  solutionCode  String?
  testCode      String             // JS assertion source evaluated in runner context
  order         Int                @default(0)
  isPublished   Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module        Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses    ChallengeProgress[]

  @@unique([courseId, dashedName])
  @@unique([moduleId, order])
  @@index([courseId])
  @@index([moduleId])
}

model ChallengeProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    String
  moduleId    Int
  challengeId Int
  completedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId, courseId])
  @@index([userId, moduleId])
}

model InternshipProgram {
  id           Int                     @id @default(autoincrement())
  slug         String                  @unique
  title        String
  description  String
  // Links to an existing Course Category slug. Kept a plain String (not an FK):
  // the category taxonomy is owned by the course catalog, and an internship
  // program must not pin or be pinned by category edits.
  categorySlug String?
  duration     String
  // "Remote" | "Onsite" | "Hybrid" — String (not enum), matching the project
  // convention for role/status-like fields (issue #77).
  mode         String
  // Closed programs stay in the DB for existing applications; they simply stop
  // being listed publicly.
  isOpen       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  applications InternshipApplication[]
}

model InternshipApplication {
  id                  Int               @id @default(autoincrement())
  // Human-readable reference shown to the student, e.g. "INT-2026-0001".
  applicationCode     String            @unique
  userId              Int
  programId           Int
  fullName            String
  email               String
  phone               String?
  qualification       String
  skills              String
  introduction        String
  portfolioUrl        String?
  message             String?
  // Workflow state: PENDING | UNDER_REVIEW | APPROVED | REJECTED | NEED_MORE_INFO.
  // String (not enum), matching the project convention (issue #77).
  status              String            @default("PENDING")
  adminResponse       String?
  // Delivery state of the response email: NOT_SENT | SENT | FAILED.
  // LOGICALLY SEPARATE from `status` — a decision is recorded and auditable even
  // when the notification email is unconfigured or fails to send, so the two
  // must never be conflated into one "responded" flag.
  responseEmailStatus String            @default("NOT_SENT")
  respondedAt         DateTime?
  // Admin User.id that responded. Deliberately a plain id, not a relation: the
  // audit trail only needs the id, and a second User relation would add a
  // second named edge on User for no query benefit.
  respondedBy         Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program InternshipProgram @relation(fields: [programId], references: [id])

  @@index([userId])
  @@index([programId])
  @@index([status])
}
