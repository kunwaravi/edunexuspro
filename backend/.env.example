# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Required (app refuses to start without these — see issue #65) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/edunexus
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=https://edunexus.kibm.in
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
REDIS_URL=redis://localhost:6379

# --- Outbound email (internship application responses) ---
# Leave SMTP_HOST unset to disable sending entirely — the API stays fully
# functional and no message is ever reported as sent. When set, port 465 uses
# implicit TLS and every other port negotiates STARTTLS.
# SMTP_FROM is optional; it falls back to SMTP_USER, then ADMIN_EMAIL.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=change-me
# SMTP_FROM=EduNexus Pro <notifications@example.com>
